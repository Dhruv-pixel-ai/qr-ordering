# Copy this file to .env and fill in your values. NEVER commit .env to git.

# MongoDB Atlas connection string (get it from Atlas → Connect → Drivers).
# For a quick local trial WITHOUT a database, use:  MONGODB_URI=memory
# (memory mode loses all data on restart — do not use in production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name (any name you like; Atlas creates it automatically)
DB_NAME=kds_cafe

# Port the server listens on (most cloud hosts set this for you automatically)
PORT=3000

# Number of tables in the restaurant
TOTAL_TABLES=50

# OPTIONAL — only for public/cloud hosting:
# The public URL of your deployed app, used inside the printed table QR codes.
# If not set, QR codes use the machine's local network IP (fine for local WiFi use).
# BASE_URL=https://your-app.example.com
